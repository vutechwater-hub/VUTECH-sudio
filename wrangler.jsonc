{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vutech-sudio",
  "main": "worker.ts",
  "compatibility_date": "2025-02-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
